	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_convert_sim.dir/build.make CMakeFiles/test_convert_sim.dir/test/bf16/test_convert_sim.cpp.s
.PHONY : test/bf16/test_convert_sim.cpp.s

